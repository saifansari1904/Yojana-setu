# Yojana Setu — environment variables
#
# Copy this file to `.env` and fill in values as needed.
# Currently the app requires NO environment variables to run:
# all scheme data, matching, and persistence are client-side.
#
# The only variable read by the build tooling is DISABLE_HMR,
# which is set by the AI Studio hosting environment (not by you).
# Leave it unset for normal local development.

# DISABLE_HMR=false

# --- Phase 1 backend: Schemes API (Supabase) — OPTIONAL ---
# When BOTH are set, the app hydrates scheme content from the remote
# Schemes API at boot (24h cache, bundled data as silent fallback).
# When unset (default), the app runs 100% on the bundled dataset.
# Use the `anon` PUBLIC key here — never the service-role key.
# VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
